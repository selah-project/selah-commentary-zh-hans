{:tier :glm-5.2, :verse 18, :comments ["<b>ערב</b> —— 夜的开始。" "<b>ובקר</b> —— 白昼的开始。" "<b>וצהרים</b> —— 正午。任何人凭眼见即可知晓这些时辰；唯独在正午时分，无法藉影子的方向来辨认，只在大约半个时辰之后，影子移动之际才能分辨。"], :book "psalms", :voice :ibn-ezra, :lang :zh-Hans, :chapter 55, :timestamp "2026-07-28T01:07:41.537833845Z", :translated-from :en, :model "glm-5.2"}