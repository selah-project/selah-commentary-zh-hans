{:tier :glm-5.2, :verse 13, :comments ["<b>撕裂的狮子</b>——足以供给她的幼崽。" "<b>从丰富中</b>——如同 די 一词的用法，他偿还了他 די שה［充足的工价］。" "<b>勒死</b>——那些动物，作为他狮子的猎物和他的洞穴之物，充满他们的掠物。"], :book "nahum", :voice :ibn-ezra, :lang :zh-Hans, :chapter 2, :timestamp "2026-07-28T00:46:40.473036580Z", :translated-from :en, :model "glm-5.2"}