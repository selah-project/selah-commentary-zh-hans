{:tier :glm-5.2, :verse 4, :comments ["<b>רבת</b>——一种时间的量度。" "<b>הלעג השאננים</b>——如同 <b>הספר המקנה</b>（取得的书）。" "<b>הלעג</b>——自满者的嘲笑。" "<b>והבוז</b>——骄傲者的蔑视，这是一个词，如同 עליונים，来自词根 גאה。"], :book "psalms", :voice :ibn-ezra, :lang :zh-Hans, :chapter 123, :timestamp "2026-07-28T01:19:32.390032196Z", :translated-from :en, :model "glm-5.2"}