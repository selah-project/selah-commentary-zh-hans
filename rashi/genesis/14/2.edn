{:tier :glm-5.2, :verse 2, :comments ["<b>Bera.</b> 对天邪恶,对受造之物也邪恶。" "<b>Birsha.</b> 他在邪恶中愈加败坏。" "<b>Shinab.</b> 恨恶他在天上的父。" "<b>Shemeber.</b> 展翅欲飞,跳跃着背叛那位圣者,愿祂受颂赞。" "<b>Bela.</b> 城的名字。"], :book "genesis", :voice :rashi, :lang :zh-Hans, :chapter 14, :timestamp "2026-08-02T10:39:21.479754379Z", :translated-from :en, :model "glm-5.2"}