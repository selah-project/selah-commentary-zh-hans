{:tier :glm-5.2, :verse 40, :comments ["<b>上山顶那里。</b>就是那条通往以色列地的路。" "<b>我们在这里，我们要上那地方去。</b>就是以色列地。" "<b>就是雅威所说的。</b>要赐给我们——我们要上那里去。" "<b>因为我们犯了罪。</b>因为我们曾说：「我们回埃及去，岂不更好吗？」"], :book "numbers", :voice :rashi, :lang :zh-Hans, :chapter 14, :timestamp "2026-08-02T10:55:25.450157339Z", :translated-from :en, :model "glm-5.2"}